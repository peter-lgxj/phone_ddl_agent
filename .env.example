# 只填要用的 provider 的密钥；复制本文件为 .env 后填写，.env 不会被提交
# 默认执行模型与规划模型都是 deepseek(deepseek-flash)，读取 DEEPSEEK_API_KEY
DEEPSEEK_API_KEY=

# 备选视觉 provider（ACTIVE_PROVIDER=qwen/zhipu/openai）
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
OPENAI_API_KEY=

# 纯文本 provider：只能作为规划/语义模型，不能作为执行模型
MINIMAX_API_KEY=

# 可选：本地 llama-server（ACTIVE_PROVIDER=local）。默认指向 8080，不填则用默认值。
# 权重与 mmproj 需自行下载，6 GB 显存需把视觉编码器留在 CPU（见 README「本地视觉模型」）。
LOCAL_VLM_BASE_URL=http://127.0.0.1:8080/v1
LOCAL_VLM_MODEL=qwen3-vl-8b-instruct
LOCAL_VLM_API_KEY=local

# 可选：YOLO 权重路径；默认 models/input_box.pt（随仓库分发，含 input_box + search_icon 两类）。
# 指向其它权重时，只有含 search_icon 类别才会启用搜索图标的视觉候选。
GUI_MODEL_PATH=models/input_box.pt

# 可选：DDL 网页入口写操作令牌。设置后，POST/DELETE 需带 X-DDL-Token 请求头；
# 不设置时只允许本机（127.0.0.1 / ::1）调用。
DDL_WEB_TOKEN=

# 可选：观察并入决策（默认 1）、OCR 启动预热（默认 1）、自适应 settle（默认 adaptive）
MERGED_OBSERVE=1
OCR_PREHEAT=1
OBSERVE_SETTLE_MODE=adaptive
OBSERVE_SETTLE_SECONDS=1.0
OBSERVE_SETTLE_POLL_SECONDS=0.15
# 只读保护：默认 1，拒绝 send / press_enter / type
READ_ONLY_MODE=1
# 屏幕驱动：auto（默认，Android 17 自动回退 adb_dump）/ uiautomator2 / adb_dump
SCREEN_DRIVER=auto
